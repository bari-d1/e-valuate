# Copied to .env by ../dev.sh on first run. Never commit .env.

# Local Postgres. With Homebrew Postgres this uses your macOS login, no password needed.
DATABASE_URL=postgresql+psycopg://localhost:5432/cw_board_eval

# Needed only for AI question generation and report writing.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Where participant portal links point.
PARTICIPANT_PORTAL_BASE_URL=http://localhost:5173

# Show full error details in API responses (local development only).
DEBUG_API_ERRORS=1

# Optional: protect consultant endpoints with a key (leave empty locally).
CONSULTANT_API_KEY=

# Email is off by default. To try it locally, run a mail catcher on port 1025
# (e.g. `brew install mailpit && mailpit`) and set EMAIL_ENABLED=true.
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=board-eval@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
